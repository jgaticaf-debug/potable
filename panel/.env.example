# Plantilla de configuracion del panel. Copie a .env y ajuste el valor.
#
# No es obligatorio: sin .env el panel cae en http://localhost:3000, que es lo
# que se usa mientras se desarrolla con el API corriendo en la misma maquina.
# Cree el archivo solo si quiere apuntar a otro lado, por ejemplo para probar
# el panel local contra el API ya desplegado.

VITE_API_URL=http://localhost:3000

# En produccion esto NO va como archivo, va como variable del servicio en el
# proveedor. Y ojo con el momento: Vite la incrusta al compilar, no la lee al
# arrancar, asi que si se cambia hay que volver a desplegar.

# ADVERTENCIA
# Todo lo que empiece con VITE_ termina dentro del JavaScript que se descarga
# el navegador, y cualquiera puede leerlo. Aqui solo van cosas publicas. El
# JWT_SECRET, la DATABASE_URL y cualquier otra credencial viven unicamente en
# el backend.
