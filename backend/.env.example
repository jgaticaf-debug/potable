# Plantilla de configuracion del API. Copie a .env y ajuste los valores.

PORT=3000
NODE_ENV=development

# --- Base de datos ---
# En Railway o Render no se define nada de esto: el proveedor inyecta
# DATABASE_URL y esa manda sobre las variables sueltas de abajo.
# DATABASE_URL=postgresql://usuario:clave@host:5432/railway
#
# El TLS lo decide el dominio: las redes .internal van sin cifrar y el resto
# con. Solo defina DATABASE_SSL si necesita forzarlo.
# DATABASE_SSL=true

PGHOST=localhost
PGPORT=5432
PGDATABASE=potable
PGUSER=postgres
PGPASSWORD=su-contrasena

# Base a la que conectarse para poder crear/eliminar la de trabajo.
PGDATABASE_ADMIN=postgres

# --- Autenticacion ---
# Aqui si es un secreto real: este archivo nunca sale del servidor.
JWT_SECRET=genere-uno-con-openssl-rand-base64-48
JWT_VIGENCIA_HORAS=8
PBKDF2_ITERACIONES=12000

# Clave con la que se siembran las cuentas de demostracion.
CLAVE_DEMO=defina-una-clave

# Origenes permitidos por CORS, separados por coma. Vacio = todos (solo dev).
CORS_ORIGENES=
