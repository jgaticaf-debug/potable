# Plantilla de configuracion de la app. Copie a .env y ajuste los valores.
# Sin este archivo la app no arranca: pubspec.yaml lo declara como asset.

# --- API ---
API_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=8000

# En produccion va la URL del API desplegado.
#
# Desde un telefono fisico, localhost es el telefono mismo, no la computadora.
# Para probar contra el API local hay que poner la IP de la maquina en la red
# (por ejemplo http://192.168.1.15:3000) y que las dos esten en el mismo wifi.

# --- Que implementacion usar ---
# En true la app corre contra datos falsos en memoria, sin API ni base. Sirve
# para trabajar la interfaz sin levantar nada.
USAR_MOCK=false

# Sin valor lo decide la plataforma: BLE donde hay radio, simulado donde no.
# Solo se fija a mano para forzar uno de los dos.
# USAR_SENSOR_BLE=true

# --- Solo para el modo mock ---
# Estos valores NO viajan al API ni tienen que coincidir con los del backend.
# El mock firma y verifica sus propios tokens dentro de la app.
JWT_SECRET=cualquier-cadena-larga-solo-para-el-mock
JWT_VIGENCIA_HORAS=8
PBKDF2_ITERACIONES=12000
CLAVE_DEMO=agua2026

# Latencia y fallas simuladas, para ver como se comporta la interfaz cuando la
# red va lenta o la sincronizacion falla.
LATENCIA_BASE_MS=320
SINCRONIZACION_FALLAS_INICIALES=0

# ADVERTENCIA
# flutter_dotenv empaqueta este archivo dentro del APK o del IPA. Cualquiera
# que tenga la app instalada puede extraerlo y leerlo. Por eso aqui solo van
# valores del modo mock y la URL publica del API. El JWT_SECRET de verdad, el
# del backend, nunca debe aparecer aqui: con el se podrian firmar tokens
# validos contra el API real.
